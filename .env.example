# Copie ce fichier en .env et remplis. Noms seulement ici, jamais de valeurs
# reelles dans git. En prod, ces variables vivent dans Railway.

# Django
SECRET_KEY=change-moi
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Base de donnees, format: postgres://user:password@localhost:5432/planner_db
DATABASE_URL=

# LLM (l'agent v2 tourne sur DeepSeek, l'import d'horaire et le chat v1 sur
# Gemini; mets TES cles de dev, jamais celles de prod)
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
HF_API_KEY=

# Auth sociale
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=

# Medias
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Resend en prod)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Reveil silencieux APNs (inutile en local sans iPhone de dev)
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_AUTH_KEY=

# MCP
MCP_OAUTH_SECRET=
